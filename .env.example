# Copier en .env.local (jamais commité) et renseigner une vraie clé.
# https://resend.com/api-keys
RESEND_API_KEY=

# Adresse qui reçoit les demandes de réservation.
BOOKING_TO_EMAIL=sitetouristiquedebogo1@gmail.com

# Adresse d'expédition. onboarding@resend.dev fonctionne sans domaine
# vérifié (utile pour démarrer) ; à remplacer par une adresse sur un
# domaine vérifié dans Resend une fois le site en production.
BOOKING_FROM_EMAIL=Ebogo Tourisme <onboarding@resend.dev>
